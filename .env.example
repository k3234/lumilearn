# LumiLearn 环境配置文件

# ============================================================
# 应用安全配置（禁止使用硬编码默认值，生产环境缺失将拒绝启动）
# 生成强随机密钥: python -c "import secrets;print(secrets.token_hex(32))"
# ============================================================
# 主 API 服务的 session 加密密钥（docker-compose 中 ${SECRET_KEY:-} 引用）
SECRET_KEY=
# 三个 Web 入口的 session 加密密钥（生产环境必填）
STUDENT_SECRET_KEY=
TEACHER_SECRET_KEY=
# 管理员初始密码（首次部署时设置；未设置则随机生成并打印到日志）
# 任务示例中的 ADMIN_PASSWORD 由本变量承担，请修改为强密码
LUMILEARN_ADMIN_INITIAL_PASSWORD=change_me
# 环境标志: production / prod 时启用 fail-closed（缺失密钥拒绝启动）
LUMILEARN_ENV=development

# ============================================================
# 服务端口配置（docker-compose 中 ${VAR:-default} 引用，默认值保持与镜像一致）
# ============================================================
# 主 API 服务宿主机端口
API_PORT=5010
# 教师端宿主机端口
TEACHER_PORT=5001
# Admin 管理面板宿主机端口
LUMILEARN_PORT=18080
# 学习分析仪表盘宿主机端口
ANALYTICS_PORT=18090
# Ollama 模型推理服务宿主机端口
OLLAMA_PORT=11434
# Nginx 反向代理宿主机端口
NGINX_PORT=80

# ============================================================
# 远程服务器训练服务器 SSH 配置（远程训练/部署脚本使用）
# 通过环境变量注入，仓库中不保存真实主机/密码
# ============================================================
REMOTE_HOST=192.168.xx.xx
REMOTE_USER=your_username
REMOTE_PASSWORD=your_password_here
REMOTE_SSH_PORT=22

# ============================================================
# Ollama API 配置（默认指向远程服务器服务器，也可改为 localhost）
# ============================================================
OLLAMA_BASE_URL=http://192.168.2.xx:11434
OLLAMA_MODEL=lumilearn-v2:latest

# ============================================================
# 支付宝支付配置 (alipay-payment-integration)
# ============================================================
# 沙箱环境（默认true，测试时使用）
ALIPAY_SANDBOX=true
# 沙箱网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式网关：https://openapi.alipay.com/gateway.do

# 支付宝应用ID（从支付宝开放平台获取）
ALIPAY_APP_ID=your_app_id_here

# 应用私钥（RSA2签名，使用支付宝开放平台开发助手生成）
ALIPAY_PRIVATE_KEY=your_private_key_here

# 支付宝公钥（从支付宝开放平台获取）
ALIPAY_PUBLIC_KEY=your_alipay_public_key_here

# 异步通知地址（用户配置你自己的服务器地址）
ALIPAY_NOTIFY_URL=http://your-domain.com/api/payment/notify

# 同步返回地址（用户配置）
ALIPAY_RETURN_URL=http://your-domain.com/api/payment/return

# ============================================================
# SOLO API 配置（如果使用）
# ============================================================
SOLO_API_KEY=your_solo_api_key_here

# ============================================================
# 云端模型 API Key（lumilearn_config.py CLOUD_MODELS 读取，配置后可切换云端模型）
# ============================================================
DOUBAO_API_KEY=your_doubao_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# 数据路径配置
MASTER_DATA_PATH=./lumilearn_master.csv
TRAINING_DATA_PATH=./training_data

# 模型训练配置
BATCH_SIZE=4
LEARNING_RATE=3e-4
MAX_EPOCHS=50

# 日志级别
LOG_LEVEL=INFO

# 项目路径
PROJECT_ROOT=.
